APP_ENV=development
NURTURESHIELD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated Chrome extension IDs. Leave empty until the extension is loaded.
NURTURESHIELD_EXTENSION_IDS=
# Optional server-to-server key used by the NurtureNet proxy.
NURTURESHIELD_INTERNAL_API_KEY=
# Requests per identity and rolling window. The in-memory limiter is per process.
NURTURESHIELD_RATE_LIMIT_REQUESTS=60
NURTURESHIELD_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum JSON request body size for the API.
NURTURESHIELD_MAX_REQUEST_BODY_BYTES=16384
